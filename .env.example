# STEAM_API_KEY: Used to fetch Steam library playtime and achievements for claimed games.
# Provided by the user or configured via Secrets panel in AI Studio.
STEAM_API_KEY=A5946B8A131FE51206631D8A0B3101BF

# DISCOGS_API_TOKEN: Optional Discogs Personal Access Token to search Discogs official soundtrack database.
# Configure via Secrets panel in AI Studio.
DISCOGS_API_TOKEN=DISCOGS_API_TOKEN_PLACEHOLDER

# SPOTIFY_CLIENT_ID & SPOTIFY_CLIENT_SECRET: Optional Spotify Web API Developer credentials for official album metadata.
# Configure via Secrets panel in AI Studio.
SPOTIFY_CLIENT_ID=SPOTIFY_CLIENT_ID_PLACEHOLDER
SPOTIFY_CLIENT_SECRET=SPOTIFY_CLIENT_SECRET_PLACEHOLDER
